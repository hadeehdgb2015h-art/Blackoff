# Blackoff server environment (copy to server/.env on the host; never commit real values)
NODE_ENV=production
# Bind address/port of the Node process. Pick a free port on your server; nginx proxies to it.
HOST=127.0.0.1
PORT=8787
# Public URL path prefix under your domain (e.g. /blackoff/) and the WebSocket path.
PUBLIC_BASE_PATH=/
WS_PATH=/ws
# Postgres connection (phase 4)
DATABASE_URL=postgres://blackoff:CHANGE_ME@127.0.0.1:5432/blackoff
# Telegram bot token from @BotFather, used ONLY server-side to verify initData HMAC (phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
# Must stay 0 in production. Allows a fake identity for local bot/browser testing.
ALLOW_DEV_AUTH=0
LOG_LEVEL=info
