# Blackoff server environment. deploy/install.sh writes the real file to
# /opt/blackoff/.env (mode 600) and fills in every value; this is only a reference.
# Never commit real values.
NODE_ENV=production
# Bind address/port of the Node process; nginx proxies /ws to it. The installer picks a free port.
HOST=127.0.0.1
PORT=8787
WS_PATH=/ws
# Shared game data (rules, maps) of the running release.
SHARED_DIR=/opt/blackoff/current/shared
# Postgres connection for player profiles (created by the installer). Empty = in-memory profiles.
DATABASE_URL=postgres://blackoff:CHANGE_ME@127.0.0.1:5432/blackoff
# Telegram bot token from @BotFather, used ONLY server-side to verify initData (HMAC-SHA256)
TELEGRAM_BOT_TOKEN=
# the bot's @username without @, for invite links; empty = asked from Telegram at start
TELEGRAM_BOT_USERNAME=
# owners' Telegram ids (comma separated): bot /admin panel and in-game DEV powers; default from deploy/owner.env
ADMIN_TELEGRAM_IDS=
# 0 = the game server does not answer the bot's messages (another program owns the bot)
BOT_POLLING=1
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
# Must stay 0 in production. Allows a fake identity for local bot/browser testing.
ALLOW_DEV_AUTH=0
LOG_LEVEL=info
# TON points per zombie kill, in millionths of a TON (1000 = 0.001 TON). 0 turns the hunt off.
TON_MICRO_PER_KILL=1000
# Shown on the weekly leaderboard in the game (what the top hunter wins; you pay it by hand)
TON_PRIZE_TEXT=
# Phase 31 puzzles: the owner's key opens the encrypted puzzle module. Leave it
# empty and send the key to the bot instead (/admin -> 🧩), it is kept in the database.
PUZZLE_KEY=
# TON points (millionths) for each player who solves the five puzzles (1000000 = 1 TON)
PUZZLE_TON_MICRO=1000000
# Voice chat between players of a zone (relayed by the server, never decoded). 0 = off.
VOICE_CHAT=1
# Secret for the owner-only pages /admin/leaderboard?token=... and /admin/suspects?token=...
ADMIN_TOKEN=
# Installer / updater settings
BLACKOFF_DOMAIN=blackoff.203-0-113-7.sslip.io
BLACKOFF_TLS=1
BLACKOFF_PM2=/usr/bin/pm2
BLACKOFF_RELEASE_URL=https://github.com/hadeehdgb2015h-art/Blackoff/releases/download/edge
