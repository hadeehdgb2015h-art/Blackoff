    "lifetimeSec": 22,
    "pickupRadius": 1.3,
    "maxOnGround": 1,
    "types": {
      "instaKill": {"displayName": "INSTA-KILL", "weight": 3, "durationSec": 20},
      "doublePoints": {"displayName": "DOUBLE POINTS", "weight": 3, "durationSec": 25},
