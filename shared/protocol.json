{
  "schemaVersion": 1,
  "protocolVersion": 8,
  "endianness": "little",
  "frame": "u8 messageId followed by fields in declared order; one message per WebSocket binary frame. Decoders reject unknown ids, short frames and trailing bytes.",
  "primitives": {
    "u8": "unsigned 8-bit",
    "u16": "unsigned 16-bit",
    "u32": "unsigned 32-bit",
    "i8": "signed 8-bit",
    "i16": "signed 16-bit",
    "f32": "IEEE754 32-bit float",
    "varuint": "LEB128 unsigned, max 5 bytes",
    "str8": "u8 byte length + UTF-8 bytes (max 255)",
    "str16": "u16 byte length + UTF-8 bytes",
    "pos": "i16 quantized metres, value = raw / posScale",
    "angle": "u16 quantized radians, value = raw / 65536 * 2PI",
    "pitch": "i16 quantized radians, value = raw / 32767 * PI/2",
    "bool": "u8 0/1",
    "array8": "u8 count + items",
    "array16": "u16 count + items",
    "bytes16": "u16 byte length + raw bytes (opaque payload, e.g. a voice frame)"
  },
  "quantization": {"posScale": 64},
  "enums": {
    "entityKind": {"player": 0, "zombie": 1, "powerup": 2},
    "playerState": {"alive": 0, "downed": 1, "dead": 2, "spectating": 3},
    "zoneState": {"lobby": 0, "intermission": 1, "wave": 2, "gameOver": 3},
    "errorCode": {
      "badVersion": 1,
      "authFailed": 2,
      "zoneFull": 3,
      "rateLimited": 4,
      "badMessage": 5,
      "serverShutdown": 6
    },
    "eventKind": {
      "hit": 0,
      "kill": 1,
      "playerDowned": 2,
      "playerRevived": 3,
      "playerDied": 4,
      "waveStart": 5,
      "waveEnd": 6,
      "purchase": 7,
      "reloadDone": 8,
      "playerJoined": 9,
      "playerLeft": 10,
      "boxOpened": 11,
      "boxOffer": 12,
      "boxTaken": 13,
      "boxExpired": 14,
      "zombieAttack": 15,
      "reloadStarted": 16,
      "weaponSwitched": 17,
      "dryFire": 18,
      "purchaseDenied": 19,
      "gameOver": 20,
      "playerDamaged": 21,
      "zombieSpawned": 22,
      "playerRespawned": 23,
      "powerupDropped": 24,
      "powerupTaken": 25,
      "powerupExpired": 26,
      "playerKilled": 27,
      "infected": 28,
      "roundStart": 29,
      "roundEnd": 30
    },
    "entityFlags": {
      "moving": 1,
      "attacking": 2,
      "downed": 4,
      "reloading": 8,
      "beingRevived": 16,
      "dead": 32,
      "zombie": 64
    },
    "selfFlags": {"reloading": 1, "switching": 2},
    "shotHit": {"none": 0, "wall": 1, "zombie": 2},
    "gameMode": {"classic": 0, "infection": 1}
  },
  "types": {
    "inputButtons": "u8 bitmask: 1=fireHeld 2=reload 4=interact 8=revive 16=switchWeapon 32=firePressed (latched edge since last input)",
    "entityState": [
      ["id", "u16"],
      ["kind", "u8"],
      ["sub", "u8"],
      ["x", "pos"],
      ["y", "pos"],
      ["floor", "u8"],
      ["yaw", "angle"],
      ["hp", "u8"],
      ["flags", "u8"]
    ],
    "weaponSlot": [["weapon", "u8"], ["mag", "u8"], ["reserve", "u16"]],
    "rosterEntry": [["id", "u16"], ["name", "str8"]],
    "entitySub": "u8: zombieType index for zombies, held weapon index for players",
    "scoreEntry": [
      ["id", "u16"],
      ["name", "str8"],
      ["kills", "u16"],
      ["headshots", "u16"],
      ["downs", "u8"],
      ["revives", "u8"]
    ],
    "leaderboardEntry": [["rank", "u8"], ["name", "str8"], ["kills", "u32"], ["tonMicro", "u32"]]
  },
  "messages": {
    "C2S": {
      "hello": {
        "id": 1,
        "fields": [["protocolVersion", "u16"], ["initData", "str16"], ["resumeToken", "str8"]]
      },
      "quickPlay": {"id": 2, "fields": [["mode", "u8"], ["friend", "str8"]]},
      "input": {
        "id": 3,
        "fields": [
          ["seq", "u16"],
          ["moveX", "i8"],
          ["moveY", "i8"],
          ["yaw", "angle"],
          ["pitch", "pitch"],
          ["buttons", "u8"]
        ]
      },
      "buy": {"id": 4, "fields": [["itemId", "str8"]]},
      "ping": {"id": 5, "fields": [["clientTime", "u32"]]},
      "leave": {"id": 6, "fields": []},
      "leaderboard": {"id": 7, "fields": []},
      "voice": {"id": 8, "fields": [["seq", "u16"], ["data", "bytes16"]]},
      "voiceListen": {"id": 9, "fields": [["on", "bool"]]}
    },
    "S2C": {
      "welcome": {
        "id": 64,
        "fields": [
          ["playerId", "u32"],
          ["displayName", "str8"],
          ["resumeToken", "str8"],
          ["tickRate", "u8"],
          ["games", "u32"],
          ["kills", "u32"],
          ["bestWave", "u16"],
          ["tonMicro", "u32"],
          ["weekKills", "u32"],
          ["weekRank", "u16"],
          ["tonPerKill", "u32"],
          ["voice", "bool"],
          ["inviteCode", "str8"],
          ["botUsername", "str8"]
        ]
      },
      "zoneJoined": {
        "id": 65,
        "fields": [["zoneId", "u32"], ["mapId", "str8"], ["entityId", "u16"], ["mode", "u8"], ["friend", "u8"], ["friendName", "str8"]]
      },
      "snapshot": {
        "id": 66,
        "fields": [
          ["tick", "u32"],
          ["ackSeq", "u16"],
          ["zoneState", "u8"],
          ["wave", "u16"],
          ["remaining", "u16"],
          ["timer", "u16"],
          ["entities", "array8:entityState"],
          ["removed", "array8:u16"],
          ["instaKill", "u8"],
          ["doublePoints", "u8"],
          ["fireSale", "u8"]
        ]
      },
      "selfState": {
        "id": 67,
        "fields": [
          ["hp", "u8"],
          ["state", "u8"],
          ["currency", "u32"],
          ["slot", "u8"],
          ["weapons", "array8:weaponSlot"],
          ["flags", "u8"],
          ["revive", "u8"],
          ["bleedout", "u8"],
          ["perks", "u8"]
        ]
      },
      "event": {
        "id": 68,
        "fields": [["kind", "u8"], ["a", "u16"], ["b", "u16"], ["value", "i16"], ["flags", "u8"]]
      },
      "pong": {"id": 69, "fields": [["clientTime", "u32"], ["serverTick", "u32"]]},
      "error": {"id": 70, "fields": [["code", "u8"], ["message", "str8"]]},
      "shot": {
        "id": 71,
        "fields": [
          ["playerId", "u16"],
          ["weapon", "u8"],
          ["toX", "pos"],
          ["toY", "pos"],
          ["toZ", "pos"],
          ["hit", "u8"]
        ]
      },
      "roster": {"id": 72, "fields": [["players", "array8:rosterEntry"]]},
      "profile": {
        "id": 73,
        "fields": [
          ["games", "u32"],
          ["kills", "u32"],
          ["bestWave", "u16"],
          ["tonMicro", "u32"],
          ["weekKills", "u32"],
          ["weekRank", "u16"],
          ["tonPerKill", "u32"]
        ]
      },
      "scoreboard": {"id": 74, "fields": [["wave", "u16"], ["players", "array8:scoreEntry"]]},
      "leaderboard": {
        "id": 75,
        "fields": [
          ["week", "str8"],
          ["prize", "str8"],
          ["entries", "array8:leaderboardEntry"],
          ["myRank", "u16"],
          ["myKills", "u32"],
          ["myTonMicro", "u32"]
        ]
      },
      "voice": {"id": 76, "fields": [["entityId", "u16"], ["seq", "u16"], ["data", "bytes16"]]}
    }
  },
  "coordinates": "Sim plane is Godot (x, z); y is up. yaw=0 faces -Z, positive yaw turns left (Godot rotation.y). pitch>0 looks up.",
  "indexTables": {
    "weapon": "index into the sorted keys of weapons.json",
    "zombieType": "index into the sorted keys of zombies.json",
    "box": "index into the map's interactables of kind 'box', in file order",
    "entry": "index into the map's zombieEntries, in file order",
    "powerupTypes": "sorted keys of constants.powerups.types",
    "perks": "sorted keys of perks.json perks"
  },
  "eventFields": {
    "hit": "a=zombie id, b=player id, value=damage (rounded), flags bit0=head",
    "kill": "a=zombie id, b=player id, value=zombieType index, flags bit0=head",
    "playerDowned": "a=player id",
    "playerRevived": "a=player id, b=reviver id",
    "playerDied": "a=player id",
    "waveStart": "a=wave, value=zombie count",
    "waveEnd": "a=wave",
    "purchase": "a=player id, b=weapon index (flags 0/1) or perk index (flags 3), value=cost, flags 0=weapon 1=ammo 2=box 3=perk",
    "reloadDone": "a=player id",
    "playerJoined": "a=player id",
    "playerLeft": "a=player id",
    "boxOpened": "a=player id, b=box index, value=roll time in 0.1 s",
    "boxOffer": "a=player id, b=box index, value=weapon index",
    "boxTaken": "a=player id, b=box index, value=weapon index",
    "boxExpired": "b=box index",
    "zombieAttack": "a=zombie id, b=target player id",
    "reloadStarted": "a=player id, value=duration in 0.01 s",
    "weaponSwitched": "a=player id, b=weapon index",
    "dryFire": "a=player id",
    "purchaseDenied": "a=player id, flags 0=funds 1=full",
    "gameOver": "a=wave reached",
    "playerDamaged": "a=player id, b=source entity id, value=damage (rounded)",
    "zombieSpawned": "a=zombie id, b=zombieType index, value=entry index",
    "playerRespawned": "a=player id",
    "powerupDropped": "a=powerup entity id, b=powerupType index, value=lifetime in 0.1 s (position: snapshot entity of kind powerup)",
    "powerupTaken": "a=player id, b=powerupType index",
    "powerupExpired": "a=powerup entity id"
  },
  "snapshotFields": {
    "ackSeq": "seq of the last input the server applied for this player (client prediction replays inputs after it)",
    "remaining": "zombies left in the current wave",
    "timer": "seconds until the next wave x10 (intermission only)",
    "instaKill": "seconds left (0 = off)",
    "doublePoints": "seconds left",
    "fireSale": "seconds left"
  },
  "_tonNote": "tonMicro = TON points in millionths (1000 = 0.001 TON). Earned per kill in online zones only; the server owns every number. Prizes are paid by the owner by hand from the weekly leaderboard.",
  "_voiceNote": "Voice frames are opaque to the server: it relays each C2S voice frame to the other connected members of the zone that listen (voiceListen), stamped with the speaker's entityId. Format (client/web/voice.js): 40 ms of 16 kHz mono IMA ADPCM, 4-byte header + 320 bytes.",
  "_infectionNote": "Infection mode (gameMode 1): no AI zombies. Player entities on the infected team carry entityFlags.zombie; selfState.flags bit 4 marks the local player infected. snapshot.wave is the round, remaining the soldiers left, timer tenths of a second left in the lobby countdown, round or result pause. Events: playerKilled (a victim, b killer, flags 1 head), infected (a victim, b by), roundStart (a round, b infected count, value seconds), roundEnd (a round, flags 1 soldiers win)."
}
