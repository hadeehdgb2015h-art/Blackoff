{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "endianness": "little",
  "frame": "u8 messageId followed by fields in declared order; one message per WebSocket binary frame. Decoders reject unknown ids, short frames and trailing bytes.",
  "primitives": {
    "u8": "unsigned 8-bit",
    "u16": "unsigned 16-bit",
    "u32": "unsigned 32-bit",
    "i8": "signed 8-bit",
    "i16": "signed 16-bit",
    "f32": "IEEE754 32-bit float",
    "varuint": "LEB128 unsigned, max 5 bytes",
    "str8": "u8 byte length + UTF-8 bytes (max 255)",
    "str16": "u16 byte length + UTF-8 bytes",
    "pos": "i16 quantized metres, value = raw / posScale",
    "angle": "u16 quantized radians, value = raw / 65536 * 2PI",
    "pitch": "i16 quantized radians, value = raw / 32767 * PI/2",
    "bool": "u8 0/1",
    "array8": "u8 count + items",
    "array16": "u16 count + items"
  },
  "quantization": {
    "posScale": 64
  },
  "enums": {
    "entityKind": {
      "player": 0,
      "zombie": 1
    },
    "playerState": {
      "alive": 0,
      "downed": 1,
      "dead": 2,
      "spectating": 3
    },
    "zoneState": {
      "lobby": 0,
      "intermission": 1,
      "wave": 2,
      "gameOver": 3
    },
    "errorCode": {
      "badVersion": 1,
      "authFailed": 2,
      "zoneFull": 3,
      "rateLimited": 4,
      "badMessage": 5,
      "serverShutdown": 6
    },
    "eventKind": {
      "hit": 0,
      "kill": 1,
      "playerDowned": 2,
      "playerRevived": 3,
      "playerDied": 4,
      "waveStart": 5,
      "waveEnd": 6,
      "purchase": 7,
      "reloadDone": 8,
      "playerJoined": 9,
      "playerLeft": 10,
      "boxOpened": 11,
      "boxOffer": 12,
      "boxTaken": 13,
      "boxExpired": 14,
      "zombieAttack": 15,
      "reloadStarted": 16,
      "weaponSwitched": 17,
      "dryFire": 18,
      "purchaseDenied": 19,
      "gameOver": 20,
      "playerDamaged": 21,
      "zombieSpawned": 22
    },
    "entityFlags": {
      "moving": 1,
      "attacking": 2,
      "downed": 4,
      "reloading": 8
    },
    "selfFlags": {
      "reloading": 1,
      "switching": 2
    },
    "shotHit": {
      "none": 0,
      "wall": 1,
      "zombie": 2
    }
  },
  "types": {
    "inputButtons": "u8 bitmask: 1=fireHeld 2=reload 4=interact 8=revive 16=switchWeapon 32=firePressed (latched edge since last input)",
    "entityState": [
      [
        "id",
        "u16"
      ],
      [
        "kind",
        "u8"
      ],
      [
        "sub",
        "u8"
      ],
      [
        "x",
        "pos"
      ],
      [
        "y",
        "pos"
      ],
      [
        "floor",
