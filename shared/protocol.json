  "coordinates": "Sim plane is Godot (x, z); y is up. yaw=0 faces -Z, positive yaw turns left (Godot rotation.y). pitch>0 looks up.",
  "indexTables": {
    "weapon": "index into the sorted keys of weapons.json",
    "zombieType": "index into the sorted keys of zombies.json",
    "box": "index into the map's interactables of kind 'box', in file order",
    "entry": "index into the map's zombieEntries, in file order"
  },
  "eventFields": {
    "hit": "a=zombie id, b=player id, value=damage (rounded), flags bit0=head",
    "kill": "a=zombie id, b=player id, value=zombieType index, flags bit0=head",
    "playerDowned": "a=player id",
    "playerRevived": "a=player id, b=reviver id",
    "playerDied": "a=player id",
    "waveStart": "a=wave, value=zombie count",
    "waveEnd": "a=wave",
    "purchase": "a=player id, b=weapon index, value=cost, flags 0=weapon 1=ammo 2=box",
    "reloadDone": "a=player id",
    "playerJoined": "a=player id",
    "playerLeft": "a=player id",
    "boxOpened": "a=player id, b=box index, value=roll time in 0.1 s",
    "boxOffer": "a=player id, b=box index, value=weapon index",
    "boxTaken": "a=player id, b=box index, value=weapon index",
    "boxExpired": "b=box index",
    "zombieAttack": "a=zombie id, b=target player id",
    "reloadStarted": "a=player id, value=duration in 0.01 s",
    "weaponSwitched": "a=player id, b=weapon index",
    "dryFire": "a=player id",
    "purchaseDenied": "a=player id, flags 0=funds 1=full",
    "gameOver": "a=wave reached",
    "playerDamaged": "a=player id, b=source entity id, value=damage (rounded)",
    "zombieSpawned": "a=zombie id, b=zombieType index, value=entry index"
  },
  "snapshotFields": {
    "ackSeq": "seq of the last input the server applied for this player (client prediction replays inputs after it)",
    "remaining": "zombies left in the current wave",
    "timer": "seconds until the next wave x10 (intermission only)"
  }
}
